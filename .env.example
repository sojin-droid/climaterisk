# climaterisk configuration — copy to .env and adjust. All values have safe defaults.

# --- Orchestration backend (FastAPI) ---
CLIMATERISK_BACKEND_HOST=127.0.0.1
CLIMATERISK_BACKEND_PORT=8099

# --- Frontend (Vite dev server) ---
CLIMATERISK_FRONTEND_PORT=5174

# --- External data root (src/climaterisk/paths.py is the single resolver) ---
# Large inputs, derived products and caches that never live in Git. Layout:
#   <DATA_ROOT>/raw/  external/{kma,municipality/{sgis,source,office},other}/
#   <DATA_ROOT>/derived/{hazard_db,municipality}/  cache/  evidence/
# Resolution for every path variable: process env -> this .env -> default. "~" is expanded;
# a relative value is taken relative to the repo root (never the working directory).
CLIMATERISK_DATA_ROOT=~/Data/climaterisk
# CLIMADA's data directory (Data API cache + ledger, MRIOT, OSM, LitPop/GPW/WorldPop/E-OBS drop-ins).
# Recommended inside the data root. When set, the worker points the CLIMADA library at it through
# a project-scoped climada.conf under <DATA_ROOT>/cache/climada_conf (the user's global CLIMADA
# configuration is not touched). Unset: CLIMADA's own default applies.
# CLIMATERISK_CLIMADA_DATA_DIR=~/Data/climaterisk/external/climada
# KMA 남한상세 archives. Default: <DATA_ROOT>/external/kma
# CLIMATERISK_KMA_DIR=
# Local hazard catalogue (HDF5 + catalog.json). Default: <DATA_ROOT>/derived/hazard_db
# (a pre-migration repo-local data/hazard_db keeps serving until migrated).
# CLIMATERISK_HAZARD_DB=

# --- App runtime state (sessions, runs, SQLite; relative to repo root unless absolute) ---
CLIMATERISK_DATA_DIR=data
CLIMATERISK_LIBRARY_DIR=assets/libraries

# --- CLIMADA worker (Phase 2; project-local conda env, never a global one) ---
# Directory of the project-local CLIMADA conda (prefix) env. Build it with:
#   conda env create -f worker/climaterisk_worker/env_climada.yml --prefix ./.climada-env
CLIMATERISK_WORKER_ENV_DIR=.climada-env
# The backend runs `<WORKER_ENV_DIR>/bin/python -m <module> <run_dir>`.
CLIMATERISK_WORKER_MODULE=climaterisk_worker.run_job
# Optional: explicit interpreter path; overrides WORKER_ENV_DIR if set.
# CLIMATERISK_WORKER_PYTHON=
# Ceiling on concurrent CLIMADA worker subprocesses (further submits get HTTP 503).
# CLIMADA runs are slow, so keep this generous — it only guards a runaway script.
CLIMATERISK_MAX_WORKERS=8
# Wall-clock cap per worker run (seconds); exceeded runs are killed and reported.
CLIMATERISK_MAX_RUN_SECONDS=900

# --- Optional manual drop-in data (graceful degradation when unset) ---
# Copernicus DEM GeoTIFF (topography) for TC storm-surge (TCSurgeBathtub).
# CLIMATERISK_DEM_PATH=
# EM-DAT disaster-loss CSV (login-gated) for impact-function calibration.
# CLIMATERISK_EMDAT_PATH=

# --- Optional API keys (local .env only — never commit values) ---
# No run path requires either key today; the Data tab 현황 체크 card reports presence/length only.
# data.go.kr service key — https://www.data.go.kr (회원가입 → 마이페이지 → 인증키). Reserved for
#   the 재해연보 observed-loss series (15107318 / 15107316; docs/OBSERVED_LOSSES_KR_SPEC.md).
#   Each API also needs its own 활용신청 (usually 자동승인) under the same account.
# CLIMATERISK_DATAGOKR_KEY=
# KOSIS OpenAPI key — https://kosis.kr/openapi (회원가입 → 인증키 신청). Reserved for re-querying
#   사망원인통계 baseline mortality; the committed baseline is used without it.
# CLIMATERISK_KOSIS_KEY=

# --- Open-data fetcher (Data tab) ---
# Per-request HTTP read timeout for "Download here" (seconds).
CLIMATERISK_DOWNLOAD_TIMEOUT_SECONDS=180

# --- Logging ---
CLIMATERISK_LOG_LEVEL=INFO
